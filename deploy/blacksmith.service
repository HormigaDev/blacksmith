# BBEL Blacksmith Agent: unit de systemd para despliegue bare-metal.
#
# Instalación (como root):
#   useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin blacksmith
#   install -D -o root -g root -m 0755 target/release/blacksmith-agent /opt/blacksmith/bin/blacksmith-agent
#   install -d -o root -g blacksmith -m 0750 /etc/blacksmith
#   install -o root -g blacksmith -m 0640 agent.env /etc/blacksmith/agent.env   # ver .env.template
#   install -m 0644 deploy/blacksmith.service /etc/systemd/system/blacksmith.service
#   systemctl daemon-reload && systemctl enable --now blacksmith
#
# El binario y su directorio pertenecen a root: el usuario del servicio nunca debe poder
# reemplazar su propio ejecutable.
#
# Gestión de units: el agente no escala privilegios (NoNewPrivileges= lo impide). Para que pueda
# arrancar o parar servicios, añada una regla de polkit que autorice
# `org.freedesktop.systemd1.manage-units` al usuario `blacksmith`, limitada a la lista
# explícita de units gestionadas, nunca a todas.

[Unit]
Description=BBEL Blacksmith Agent
Documentation=https://github.com/HormigaDev/bbel-blacksmith
After=network.target
# Evita bucles de reinicio infinitos: como mucho 5 arranques fallidos por minuto.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# El agente avisa con sd_notify(READY=1) cuando ya escucha; `systemctl start` espera a ese aviso.
Type=notify
NotifyAccess=main
ExecStart=/opt/blacksmith/bin/blacksmith-agent

User=blacksmith
Group=blacksmith
# Lectura del journal de las units gestionadas (journalctl -u …).
SupplementaryGroups=systemd-journal

# Configuración no secreta (BLACKSMITH_*). root:blacksmith 0640.
Environment=BLACKSMITH_ENV=production
EnvironmentFile=/etc/blacksmith/agent.env
# Secretos como credenciales de systemd: se montan en un tmpfs privado (0400), no aparecen en
# el entorno y no los heredan los procesos hijos. Descomente las dos líneas cuando cree el
# archivo (root:root 0600); si falta, la unit no arranca.
#LoadCredential=github-webhook-secret:/etc/blacksmith/credentials/github-webhook-secret
#Environment=BLACKSMITH_GITHUB_WEBHOOK_SECRET_FILE=/run/credentials/blacksmith.service/github-webhook-secret

# glibc crea un arena de malloc por hilo; limitarlos mantiene la RSS baja (objetivo < 20 MB).
Environment=MALLOC_ARENA_MAX=2

Restart=on-failure
RestartSec=2
# 77 (EX_NOPERM) y 78 (EX_CONFIG) no se arreglan reintentando.
RestartPreventExitStatus=77 78
# Debe ser mayor que BLACKSMITH_SHUTDOWN_TIMEOUT_SECS (10 s por defecto).
TimeoutStopSec=30
# SIGTERM solo al proceso principal, para que drene. Lo que quede (p. ej. un `journalctl -f`
# hijo) recibe SIGKILL al terminar el plazo.
KillMode=mixed

# Límites de recursos
MemoryHigh=48M
MemoryMax=64M
TasksMax=128
LimitNOFILE=4096
LimitCORE=0

# Endurecimiento. Comprobar con: systemd-analyze security blacksmith.service
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Oculta los /proc/<pid> de otros usuarios. /proc/stat y /proc/meminfo siguen disponibles; las
# métricas por servicio se leen de la contabilidad de cgroups de systemd, no de /proc.
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# AF_UNIX: D-Bus (systemctl), journald y sd_notify.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# El agente solo habla con loopback (Nginx y el túnel SSH). Las tareas que necesiten red
# (p. ej. git fetch al desplegar) deben ejecutarse en su propia unit transitoria con su propio
# sandbox, no relajando esta.
IPAddressDeny=any
IPAddressAllow=localhost
# Cuando el agente tenga que escribir archivos (p. ej. los .env de los proyectos), declare
# aquí rutas concretas con ReadWritePaths=, nunca directorios amplios.

[Install]
WantedBy=multi-user.target
