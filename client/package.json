{
    "name": "blacksmith-client",
    "version": "0.1.0",
    "description": "Cliente de escritorio de BBEL Blacksmith",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:styles && pnpm check:i18n && pnpm format:check",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "check:styles": "node scripts/check-styles.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "tauri": "tauri",
        "check:i18n": "node scripts/check-i18n.mjs"
    },
    "license": "MIT",
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-opener": "^2"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.65.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tauri-apps/cli": "^2",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.3",
        "svelte-check": "^4.6.0",
        "typescript": "~6.0.3",
        "vite": "^8.0.16"
    },
    "private": true
}
