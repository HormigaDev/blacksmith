# Configuración del agente (Blacksmith).
#
# - Este archivo solo lo leen los builds de desarrollo (`cargo run -p agent`), y solo desde el
#   directorio actual. Los binarios release nunca leen `.env`: en producción el entorno viene
#   de /etc/blacksmith/agent.env (EnvironmentFile= en deploy/blacksmith.service), que se instala
#   desde deploy/agent.env.
# - Las variables ya exportadas en la shell tienen prioridad sobre este archivo.
# - Cualquier variable BLACKSMITH_* desconocida es un error de arranque. Las vacías cuentan
#   como no definidas.

# Obligatoria: development | production. Los binarios release solo aceptan `production`.
BLACKSMITH_ENV=development

# Solo direcciones loopback (127.0.0.0/8 o ::1). Por defecto: 127.0.0.1:4040
BLACKSMITH_BIND_ADDR=127.0.0.1:4040

# Directiva de tracing EnvFilter. Por defecto, development: info,agent=debug,tower_http=debug;
# production: info
BLACKSMITH_LOG=
# pretty | compact | json. Por defecto, development: pretty; production: json
BLACKSMITH_LOG_FORMAT=

# Runtime de tokio. Por defecto: 2 hilos de trabajo y 16 bloqueantes.
BLACKSMITH_WORKER_THREADS=
BLACKSMITH_MAX_BLOCKING_THREADS=

# Límites HTTP. Por defecto: 30 s por petición (1-300), 10 s de drenado al parar (1-120),
# 1 MiB de cuerpo (1 KiB-25 MiB) y 128 peticiones simultáneas (1-4096); al superar ese número
# se responde 503 en vez de encolar.
BLACKSMITH_REQUEST_TIMEOUT_SECS=
BLACKSMITH_SHUTDOWN_TIMEOUT_SECS=
BLACKSMITH_BODY_LIMIT_BYTES=
BLACKSMITH_MAX_CONCURRENCY=

# Ruta a un archivo con el secreto del webhook de GitHub, de 32 a 256 bytes y con permisos
# 0600/0400. Si se deja vacía, los webhooks quedan deshabilitados. El secreto nunca se pone
# directamente en una variable de entorno: la heredarían los procesos hijos.
#   mkdir -p .secrets && (umask 077 && openssl rand -hex 32 > .secrets/github-webhook)
BLACKSMITH_GITHUB_WEBHOOK_SECRET_FILE=

# Archivo SQLite del agente; se crea con permisos 0600 (y su directorio con 0700) si no existe.
# Por defecto, development: .data/agent.db (relativa al directorio actual); production:
# /var/lib/blacksmith/agent.db (debe ser absoluta). Al actualizar el agente, el esquema se migra
# solo.
BLACKSMITH_DATABASE_PATH=

# Visores de logs en tiempo real abiertos a la vez (1-32). Por defecto: 4. Cada uno es un
# proceso `journalctl -f` (~1 MB propio) que cuenta para el MemoryMax= de la unidad; al
# superarlo, el agente responde 503 LOG_STREAM_LIMIT en vez de abrir otro.
BLACKSMITH_MAX_LOG_STREAMS=

# Gestor de systemd de los servicios desplegados: system | user. Por defecto, development: user
# (modo local: el systemd de tu usuario, sin root; el agente instala las plantillas al arrancar);
# production: system. Define también las rutas (ver agent/src/deploy/paths.rs).
BLACKSMITH_SYSTEMD_SCOPE=
