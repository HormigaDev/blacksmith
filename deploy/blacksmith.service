# Blacksmith Agent: unit de systemd para despliegue bare-metal.
#
# Instalación (como root):
#   for user in blacksmith blacksmith-apps blacksmith-fetch; do
#       useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$user"
#   done
#   install -D -o root -g root -m 0755 target/release/blacksmith-agent /opt/blacksmith/bin/blacksmith-agent
#   install -d -o root -g blacksmith -m 0750 /etc/blacksmith
#   install -o root -g blacksmith -m 0640 deploy/agent.env /etc/blacksmith/agent.env
#   install -o root -g root -m 0644 deploy/polkit/10-blacksmith.rules /etc/polkit-1/rules.d/
#   install -m 0644 deploy/systemd/*.service /etc/systemd/system/
#   install -m 0644 deploy/blacksmith.service /etc/systemd/system/blacksmith.service
#   systemctl daemon-reload && systemctl enable --now blacksmith
# Guía completa (paquetes, verificación, nginx y webhooks): README.md, «Complete setup guide».
#
# Tres usuarios: el agente (`blacksmith`), los servicios (`blacksmith-apps`) y el clon de los
# repositorios (`blacksmith-fetch`). Solo el agente tiene permisos de polkit; ver
# agent/src/deploy/units.rs.
#
# El binario y su directorio pertenecen a root: el usuario del servicio nunca debe poder
# reemplazar su propio ejecutable.
#
# Gestión de units: el agente no escala privilegios (NoNewPrivileges= lo impide). Solo puede
# actuar sobre sus unidades (`blacksmith@`, `blacksmith-fetch@`, `blacksmith-deploy@`, nginx y
# certbot) porque así lo autoriza la regla de polkit deploy/polkit/10-blacksmith.rules; cualquier
# otra petición suya a polkit se deniega.

[Unit]
Description=Blacksmith Agent
Documentation=https://github.com/HormigaDev/blacksmith
After=network.target
# Evita bucles de reinicio infinitos: como mucho 5 arranques fallidos por minuto.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# El agente avisa con sd_notify(READY=1) cuando ya escucha; `systemctl start` espera a ese aviso.
Type=notify
NotifyAccess=main
ExecStart=/opt/blacksmith/bin/blacksmith-agent

User=blacksmith
Group=blacksmith
# Lectura del journal de las units gestionadas (journalctl -u …).
SupplementaryGroups=systemd-journal

# Base de datos (BLACKSMITH_DATABASE_PATH, por defecto /var/lib/blacksmith/agent.db). systemd crea
# el directorio, propiedad de blacksmith, y es lo único escribible con ProtectSystem=strict.
StateDirectory=blacksmith
StateDirectoryMode=0700
# Variables de entorno de los servicios (/etc/blacksmith/env): systemd crea el directorio, propiedad de
# blacksmith y 0700, y lo deja escribible pese a ProtectSystem=strict. Las cargan las plantillas
# deploy/systemd/blacksmith@.service y blacksmith-deploy@.service.
ConfigurationDirectory=blacksmith/env
ConfigurationDirectoryMode=0700

# Configuración no secreta (BLACKSMITH_*). root:blacksmith 0640.
Environment=BLACKSMITH_ENV=production
EnvironmentFile=/etc/blacksmith/agent.env
# El secreto de los webhooks llega como credencial de systemd (tmpfs privado, fuera del entorno)
# con un drop-in que crea deploy/nginx/install-webhooks.sh: no edite esta unidad para eso.

# glibc crea un arena de malloc por hilo; limitarlos mantiene la RSS baja (objetivo < 20 MB).
Environment=MALLOC_ARENA_MAX=2

Restart=on-failure
RestartSec=2
# 77 (EX_NOPERM) y 78 (EX_CONFIG) no se arreglan reintentando.
RestartPreventExitStatus=77 78
# Debe ser mayor que BLACKSMITH_SHUTDOWN_TIMEOUT_SECS (10 s por defecto).
TimeoutStopSec=30
# SIGTERM solo al proceso principal, para que drene. Lo que quede (p. ej. un `journalctl -f`
# hijo) recibe SIGKILL al terminar el plazo.
KillMode=mixed

# Límites de recursos
MemoryHigh=48M
MemoryMax=64M
TasksMax=128
LimitNOFILE=4096
LimitCORE=0

# Endurecimiento. Comprobar con: systemd-analyze security blacksmith.service
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# El consumo de los servicios sale de su cgroup (systemd y /sys/fs/cgroup), no de /proc: el agente
# no necesita ver procesos de otros usuarios.
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# AF_UNIX: D-Bus (systemctl), journald y sd_notify. AF_NETLINK: leer las direcciones de red del
# servidor (GET /api/v1/host); sin CAP_NET_ADMIN, netlink solo permite consultar, no cambiar nada.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# El agente solo habla con loopback (Nginx y el túnel SSH). Lo que necesita red (el clon de un
# despliegue) corre en su propia unidad (blacksmith-fetch@), no relajando esta.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
