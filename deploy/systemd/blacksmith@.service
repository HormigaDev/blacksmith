# Generada por Blacksmith (agent/src/deploy/units.rs): no la edite a mano.
# Servicio desplegado %i: ejecuta la versión activa (%S/blacksmith-apps/%i/app).

[Unit]
Description=Blacksmith: %i
After=network-online.target
Wants=network-online.target
# Sin una versión desplegada no hay nada que arrancar.
ConditionPathIsSymbolicLink=%S/blacksmith-apps/%i/app

[Service]
Type=exec
User=blacksmith-apps
Group=blacksmith-apps
StateDirectory=blacksmith-apps/%i
StateDirectoryMode=0711
UMask=0077
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
Environment=HOME=%S/blacksmith-apps/%i
EnvironmentFile=-%E/blacksmith/env/global.env
EnvironmentFile=-%E/blacksmith/env/services/%i.env
WorkingDirectory=%S/blacksmith-apps/%i/app
ExecStart=/opt/blacksmith/bin/blacksmith-agent run-service
Restart=on-failure
RestartSec=3
TemporaryFileSystem=%S/blacksmith-apps:ro
BindPaths=%S/blacksmith-apps/%i
InaccessiblePaths=-%S/blacksmith-fetch
InaccessiblePaths=-%S/blacksmith
InaccessiblePaths=-%E/blacksmith
InaccessiblePaths=-/run/dbus
ProtectProc=invisible
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
InaccessiblePaths=-/run/credentials
