{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "windows"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "dialog:allow-open",
    "allow-ssh-save-key",
    "allow-ssh-forget-host",
    "allow-tunnel-open",
    "allow-tunnel-trust-host",
    "allow-tunnel-close",
    "allow-servers-list",
    "allow-server-remove",
    "allow-server-add-local",
    "allow-local-agent-status",
    "allow-servers-reorder",
    "allow-agent-request",
    "allow-logs-follow",
    "allow-logs-stop",
    "allow-github-status",
    "allow-github-configure",
    "allow-github-use-default-app",
    "allow-github-share-with-server",
    "allow-github-add-deploy-key",
    "allow-github-login-start",
    "allow-github-login-wait",
    "allow-github-login-cancel",
    "allow-github-logout",
    "allow-github-repositories",
    "allow-github-branches",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized"
  ]
}
