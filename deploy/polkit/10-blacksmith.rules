// Blacksmith: lo único que el usuario del agente puede pedir a polkit.
//
// Instalación (como root; polkitd recarga solo al cambiar el archivo):
//   install -o root -g root -m 0644 deploy/polkit/10-blacksmith.rules /etc/polkit-1/rules.d/
//
// - Solo afecta al usuario `blacksmith`; para el resto devuelve NOT_HANDLED.
// - Le permite:
//     · start, stop y restart de `blacksmith@<nombre>.service` (los servicios desplegados), y
//       set-property para sus límites de recursos (systemd solo acepta ahí propiedades de
//       control de recursos: CPU, memoria, swap, procesos; nunca ExecStart= ni similares);
//     · start y stop de `blacksmith-deploy@<nombre>.service` (sus despliegues);
//     · start de `blacksmith-nginx.service` (valida y recarga nginx: dos órdenes fijas) y de
//       `blacksmith-certbot@<dominio>.service` (pide un certificado de Let's Encrypt). Ver deploy/nginx/.
//   Nada más: otras unidades (ssh, nginx, dbus, el propio agente…), otros verbos (enable, mask,
//   kill, set-property fuera de los servicios…), crear unidades transitorias y cualquier otra acción de polkit
//   (daemon-reload, reiniciar el equipo…) se le deniegan explícitamente, sin pasar a las reglas
//   siguientes. Es una lista de permitidos: no hace falta mantener una lista de unidades críticas.
// - El prefijo `20-`/`49-`/`50-` de las reglas de la distribución es posterior: polkit evalúa
//   por orden de nombre y gana la primera regla que decide.
// - El patrón debe coincidir con MANAGED_UNIT_PATTERN (agent/src/services/mod.rs): lo comprueba
//   un test del agente.
//
// Sintaxis ES5 a propósito: es la que admiten todos los motores de polkit (duktape y mozjs).

polkit.addRule(function (action, subject) {
    if (subject.user !== "blacksmith") {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (typeof unit === "string" && /^blacksmith(-deploy)?@[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?\.service$/.test(unit)) {
            var deploy = unit.indexOf("blacksmith-deploy@") === 0;
            if (verb === "start" || verb === "stop"
                || ((verb === "restart" || verb === "set-property") && !deploy)) {
                return polkit.Result.YES;
            }
        }
        if (verb === "start" && typeof unit === "string"
            && (unit === "blacksmith-nginx.service"
                || /^blacksmith-certbot@[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?\.service$/.test(unit))) {
            return polkit.Result.YES;
        }
    }

    return polkit.Result.NO;
});
