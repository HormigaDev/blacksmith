{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "windows"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:default",
    "dialog:allow-open",
    "allow-ssh-save-key",
    "allow-ssh-key-info",
    "allow-ssh-forget-key",
    "allow-ssh-forget-host",
    "allow-tunnel-open",
    "allow-tunnel-trust-host",
    "allow-tunnel-close",
    "allow-tunnel-status",
    "allow-servers-list",
    "allow-server-remove"
  ]
}
