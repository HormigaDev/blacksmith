# Configuración del agente en el servidor: /etc/blacksmith/agent.env (root:blacksmith 0640).
# La unidad (deploy/blacksmith.service) lo exige aunque esté vacío.
#
# Todas son opcionales: los valores por defecto son los de producción. La lista completa, con
# sus rangos, está en .env.template. Una variable BLACKSMITH_* desconocida impide arrancar.
# BLACKSMITH_ENV ya lo fija la unidad (production): no lo cambie aquí.
#
# El secreto de los webhooks no va aquí: lo configura deploy/nginx/install-webhooks.sh.

# Registro: info por defecto, en JSON (journalctl -u blacksmith).
#BLACKSMITH_LOG=info
#BLACKSMITH_LOG_FORMAT=json

# Tiempo máximo de una petición (1-300 s). Por defecto 30.
#BLACKSMITH_REQUEST_TIMEOUT_SECS=30

# Visores de logs en vivo a la vez (1-32). Por defecto 4.
#BLACKSMITH_MAX_LOG_STREAMS=4
