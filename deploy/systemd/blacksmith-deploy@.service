# Generada por Blacksmith (agent/src/deploy/units.rs): no la edite a mano.
# Despliegue de %i: copia el clon, ejecuta la preparación y activa la versión.

[Unit]
Description=Blacksmith: despliegue de %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=blacksmith-apps
Group=blacksmith-apps
StateDirectory=blacksmith-apps/%i
StateDirectoryMode=0711
UMask=0077
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
Environment=HOME=%S/blacksmith-apps/%i
EnvironmentFile=-%E/blacksmith/env/global.env
EnvironmentFile=-%E/blacksmith/env/services/%i.env
WorkingDirectory=%S/blacksmith-apps/%i
# Solo la especificación, que no lleva secretos.
LoadCredential=spec:%S/blacksmith/deployments/%i/spec.json
Environment=BLACKSMITH_SOURCE=%S/blacksmith-fetch/%i/source
ExecStart=/opt/blacksmith/bin/blacksmith-agent run-deploy
TimeoutStartSec=30min
TemporaryFileSystem=%S/blacksmith-apps:ro
BindPaths=%S/blacksmith-apps/%i
TemporaryFileSystem=%S/blacksmith-fetch:ro
BindReadOnlyPaths=-%S/blacksmith-fetch/%i
InaccessiblePaths=-%S/blacksmith
InaccessiblePaths=-%E/blacksmith
InaccessiblePaths=-/run/dbus
ProtectProc=invisible
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
