# Generada por BBEL Blacksmith (agent/src/deploy/units.rs): no la edite a mano.
# Servicio desplegado %i: ejecuta la versión activa (%S/bbel/%i/app).

[Unit]
Description=BBEL Blacksmith: %i
After=network-online.target
Wants=network-online.target
# Sin una versión desplegada no hay nada que arrancar.
ConditionPathIsSymbolicLink=%S/bbel/%i/app

[Service]
Type=exec
User=bbel
Group=bbel
StateDirectory=bbel/%i
StateDirectoryMode=0711
UMask=0077
Environment=HOME=%S/bbel/%i
EnvironmentFile=-%E/bbel/env/global.env
EnvironmentFile=-%E/bbel/env/services/%i.env
WorkingDirectory=%S/bbel/%i/app
ExecStart=/opt/blacksmith/bin/blacksmith-agent run-service
Restart=on-failure
RestartSec=3
# Solo su directorio: los demás servicios, las variables y los datos del agente no existen.
TemporaryFileSystem=%S/bbel:ro
BindPaths=%S/bbel/%i
InaccessiblePaths=-%E/bbel
InaccessiblePaths=-%S/blacksmith
ProtectProc=invisible
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
InaccessiblePaths=-/run/credentials
